{
    "name": "aam/laravel-document-scanner",
    "description": "Scan documents from physical scanners (via a local agent), review and reorder pages, build a multi-page PDF in the browser and upload it securely to Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "scanner", "wia", "sane", "twain", "pdf", "document", "upload"],
    "authors": [
        {
            "name": "AAM",
            "email": "aam.laravel@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Aam\\DocumentScanner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aam\\DocumentScanner\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aam\\DocumentScanner\\DocumentScannerServiceProvider"
            ],
            "aliases": {
                "DocumentScanner": "Aam\\DocumentScanner\\Facades\\DocumentScanner"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:js": "node --test \"tests/js/*.test.js\""
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
